# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database ---
# Local Postgres connection string. Never commit real credentials.
DATABASE_URL="postgresql://foundry:foundry@localhost:5432/imaginarium_foundry?schema=public"

# --- Auth ---
# Long random secret used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-value"
JWT_EXPIRES_IN="12h"

# --- Agents / LLM ---
# API key for the Anthropic SDK used by THOTH/ANANSI/PRODUCER/LEDGER agents.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Instagram Ingestion ---
# Selects the ingestion adapter implementation. "html-meta" fetches only
# publicly-served Open Graph metadata for a post URL and never authenticates
# against Instagram, so no session/login credentials are ever required or
# stored. Swap this for a future adapter (e.g. an official Graph API
# integration) without touching the rest of the pipeline.
INGESTION_ADAPTER="html-meta"
INGESTION_FETCH_TIMEOUT_MS=10000
INGESTION_MAX_RETRIES=3

# --- Job processing / retries ---
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_DELAY_MS=500
